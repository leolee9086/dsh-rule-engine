{
  "name": "@leolee9086/dsh-rule-engine",
  "version": "0.9.0",
  "description": "DSH 专用的规则引擎：规则校验、匹配、文本变换与有状态调度，不依赖 DSH 运行时。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./catalog-capacity": {
      "types": "./lib/catalog-capacity.d.ts",
      "default": "./lib/catalog-capacity.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leolee9086/dsh-rule-engine.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "rule-engine",
    "regex",
    "prefix-cache"
  ],
  "scripts": {
    "generate:types": "node scripts/generate-event-field-shape.mjs",
    "check:generated": "node scripts/generate-event-field-shape.mjs --check",
    "build": "pnpm check:generated && tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "pnpm build && node --test --test-concurrency=2",
    "check:types": "node scripts/check-type-contracts.mjs",
    "check": "pnpm build && pnpm lint && pnpm check:types && node --test --test-concurrency=2",
    "prepack": "pnpm check"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "handlebars": "^4.7.10",
    "mdast-util-from-markdown": "^2.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "typescript": "5.8.3"
  },
  "types": "./lib/index.d.ts"
}
